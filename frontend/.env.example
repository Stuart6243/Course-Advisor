# 前端环境变量示例。复制为 .env 后按需修改。
#
# 注意：前端本身不直接调用任何模型 API。
# 所有请求都通过 Vite proxy（见 vite.config.ts）转发到后端 http://localhost:8000，
# 因此这里不需要、也绝对不要放 GROQ_API_KEY 之类的密钥
# —— Vite 会把 VITE_ 前缀的变量打进前端产物，任何访问页面的人都能看到。

# 后端地址。默认走 vite.config.ts 里的 proxy，通常不需要改。
# 只有当后端不在 localhost:8000 时才需要设置。
VITE_API_BASE_URL=http://localhost:8000

# 开发服务器端口（也可以用 npm run dev -- --port=xxxx 覆盖）
VITE_DEV_PORT=3000
